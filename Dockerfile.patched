# syntax=docker/dockerfile:1
# ------------------------------------------------------------------------------
# PHP2Shell Vulnerability Detection Test: Patched Runtime Control Case (Test Case B)
#
# REMEDIATED VULNERABILITIES:
# - CVE-2026-109618 (Remediated in PHP 8.3.36)
# - CVE-2026-109619 (Remediated in PHP 8.3.36)
#
# RUNTIME SELECTION:
# Explicitly pinned to PHP 8.3.36 (official first fixed release in the 8.3 series)
# ------------------------------------------------------------------------------

FROM php:8.3.36-cli-alpine

LABEL org.opencontainers.image.title="php2shell-security-test-patched" \
      org.opencontainers.image.description="Patched PHP 8.3.36 runtime container for false-positive validation" \
      org.opencontainers.image.version="8.3.36" \
      org.opencontainers.image.vendor="TigerGate Validation Test"

# Non-root working environment
WORKDIR /var/www/html

# Copy repository metadata and safe application code
COPY composer.json /var/www/html/composer.json
COPY src/ /var/www/html/src/

# Run as non-privileged user
USER nobody

# Expose internal HTTP port
EXPOSE 8080

# Execute minimal built-in web server serving harmless JSON status
CMD ["php", "-S", "0.0.0.0:8080", "-t", "/var/www/html/src"]
