{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "document_type": "iac_security_evaluation_benchmark",
  "benchmark_title": "Pure Infrastructure-as-Code (IaC) Vulnerability Test Suite",
  "version": "2.0.0",
  "strict_criteria": {
    "sast_vulnerabilities_allowed": 0,
    "secret_leaks_allowed": 0,
    "sca_vulnerabilities_allowed": 0,
    "iac_misconfigurations_required": true
  },
  "modality_assertions": {
    "sast": {
      "status": "PASS",
      "expected_count": 0,
      "description": "Zero application source code vulnerabilities. No untrusted execution, injection, or malicious logic."
    },
    "secrets": {
      "status": "PASS",
      "expected_count": 0,
      "description": "Zero hardcoded credentials, API keys, passwords, or tokens. Master passwords and credentials utilize runtime variables with no default secrets."
    },
    "sca": {
      "status": "PASS",
      "expected_count": 0,
      "description": "Zero third-party dependency vulnerabilities. No vulnerable packages in manifest files."
    },
    "iac": {
      "status": "DETECTED",
      "expected_min_count": 50,
      "description": "Rich set of intentional Infrastructure-as-Code misconfigurations covering Terraform, Kubernetes, CloudFormation, and Dockerfile."
    }
  },
