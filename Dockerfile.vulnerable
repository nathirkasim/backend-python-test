# syntax=docker/dockerfile:1
# ------------------------------------------------------------------------------
# PHP2Shell Vulnerability Detection Test: Vulnerable Runtime (Test Case A)
#
# TARGET VULNERABILITIES:
# - CVE-2026-109618 (PHP hash table memory exhaustion RCE / GHSA-w8hw-w9fx-j79w)
# - CVE-2026-109619 (PHP use-after-free RCE in upload progress / GHSA-6wmf-4rv5-p3rp)
#
# RUNTIME SELECTION:
# Explicitly pinned to PHP 8.3.35 (immediately preceding the 8.3.36 fixed release)
# ------------------------------------------------------------------------------

FROM php:8.3.35-cli-alpine

LABEL org.opencontainers.image.title="php2shell-security-test-vulnerable" \
      org.opencontainers.image.description="Vulnerable PHP 8.3.35 runtime container for scanner validation" \
      org.opencontainers.image.version="8.3.35" \
      org.opencontainers.image.vendor="TigerGate Validation Test"

# Non-root working environment
WORKDIR /var/www/html

# Copy repository metadata and safe application code
COPY composer.json /var/www/html/composer.json
COPY src/ /var/www/html/src/

# Run as non-privileged user
USER nobody

# Expose internal HTTP port
EXPOSE 8080

# Execute minimal built-in web server serving harmless JSON status
CMD ["php", "-S", "0.0.0.0:8080", "-t", "/var/www/html/src"]
